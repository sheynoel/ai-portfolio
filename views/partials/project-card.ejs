<article class="project-card card h-100 border-0 overflow-hidden" role="button" tabindex="0" data-bs-toggle="modal" data-bs-target="#projectModal<%= index %>" aria-label="View details for <%= project.title %>">
  <img class="project-image card-img-top" src="<%= project.image %>" alt="<%= project.title %> preview" onerror="this.onerror=null;this.src='/images/projects/project-placeholder.svg';">
  <div class="card-body d-flex flex-column p-4">
    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
      <span class="project-status badge rounded-pill"><%= project.status %></span>
      <span class="small text-secondary"><%= project.year %></span>
    </div>
    <h3 class="h4 fw-semibold"><%= project.title %></h3>
    <p class="text-secondary small mb-3"><%= project.description %></p>
    <p class="small fw-semibold mb-3"><%= project.role %></p>
    <div class="d-flex flex-wrap gap-2 mb-4">
      <% project.technologies.slice(0, 4).forEach((technology) => { %>
        <span class="badge rounded-pill text-bg-light border"><%= technology %></span>
      <% }) %>
      <% if (project.technologies.length > 4) { %>
        <span class="badge rounded-pill text-bg-light border">+<%= project.technologies.length - 4 %></span>
      <% } %>
    </div>
    <span class="btn btn-outline-dark rounded-pill mt-auto align-self-start">View Details</span>
  </div>
</article>
