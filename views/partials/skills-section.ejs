<section id="skills" class="skills-section py-5 py-lg-6" aria-labelledby="skills-heading">
  <div class="container py-lg-5">
    <div class="row justify-content-between align-items-end mb-5">
      <div class="col-lg-7" data-reveal="left">
        <p class="hero-eyebrow mb-2">Skills &amp; Expertise</p>
        <h2 id="skills-heading" class="display-5 fw-semibold mb-0">A practical toolkit for building useful software.</h2>
      </div>
      <div class="col-lg-4 mt-3 mt-lg-0" data-reveal="right">
        <p class="text-secondary mb-0">The technologies, engineering practices, and AI tools I apply to turn ideas into dependable digital experiences.</p>
      </div>
    </div>

    <div class="row g-4">
      <% skillCategories.forEach((category, index) => { %>
        <div class="col-12 col-md-6 col-lg-4" data-reveal="up" style="--reveal-delay: <%= (index % 3) * 90 %>ms;">
          <article class="skill-category-card h-100 <%= category.learning ? 'skill-category-card--learning' : '' %>">
            <header class="d-flex align-items-center gap-3 mb-4">
              <span class="skill-category-icon" aria-hidden="true"><i class="bi <%= category.icon %>"></i></span>
              <h3 class="h5 fw-semibold mb-0"><%= category.title %></h3>
            </header>
            <ul class="skill-list list-unstyled mb-0">
              <% category.skills.forEach(([name, description]) => { %>
                <li class="skill-badge">
                  <span class="skill-badge-name"><%= name %></span>
                  <span class="skill-badge-description"><%= description %></span>
                </li>
              <% }) %>
            </ul>
          </article>
        </div>
      <% }) %>
    </div>
  </div>
</section>
